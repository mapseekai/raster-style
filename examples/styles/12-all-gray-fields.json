{
  "version": "2.0",
  "opacity": 0.8,
  "statistics": {
    "scope": "dataset",
    "accuracy": "sample",
    "sample_size": 1000
  },
  "calibration": {
    "mode": "linear",
    "coefficients": [
      {
        "band": 1,
        "scale": 0.2,
        "offset": -1
      }
    ]
  },
  "renderer": {
    "type": "gray",
    "renderer_invert": true,
    "bidx": [
      1
    ]
  },
  "stretch": {
    "method": "stddev",
    "stddev": 2.5,
    "range_policy": "transparent"
  },
  "image": {
    "format": "png",
    "tilesize": 64
  },
  "resampling": {
    "read": "cubic_spline",
    "reproject": "average"
  },
  "effects": {
    "post_color_formula": [
      {
        "op": "brightness",
        "value": 0.1
      },
      {
        "op": "contrast",
        "value": 1.5
      },
      {
        "op": "saturation",
        "value": 0.8
      },
      {
        "op": "grayscale",
        "method": "luma"
      }
    ],
    "color_formula": [
      {
        "op": "gamma",
        "channels": "r",
        "value": 1.2
      },
      {
        "op": "sigmoidal",
        "channels": "r",
        "contrast": 5,
        "midpoint": 0.4
      }
    ]
  }
}
