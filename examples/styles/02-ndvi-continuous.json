{
  "version": "2.0",
  "opacity": 1,
  "calibration": {
    "mode": "metadata"
  },
  "renderer": {
    "type": "pseudocolor",
    "color_mapping": {
      "mode": "continuous",
      "domain": "data",
      "interpolation": "srgb",
      "stops": [
        {
          "value": -1,
          "color": "#313695ff"
        },
        {
          "value": 0,
          "color": "#ffffbfff"
        },
        {
          "value": 1,
          "color": "#006837ff"
        }
      ],
      "under": "clamp",
      "over": "clamp"
    },
    "index": {
      "name": "ndvi",
      "bindings": {
        "red": 4,
        "nir": 8
      }
    }
  },
  "stretch": {
    "method": "none"
  },
  "image": {
    "format": "png",
    "tilesize": 256
  },
  "resampling": {
    "read": "bilinear",
    "reproject": "bilinear"
  }
}
