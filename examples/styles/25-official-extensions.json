{
  "version": "3.0",
  "extensions": [
    "https://mapseekai.github.io/raster-style/extensions/raster/mosaic/v1.0.0/schema.json",
    "https://mapseekai.github.io/raster-style/extensions/raster/tile/v1.0.0/schema.json"
  ],
  "renderer": {
    "type": "rgb",
    "bidx": [
      4,
      3,
      2
    ]
  },
  "resampling": {
    "read": "bilinear",
    "reproject": "bilinear"
  },
  "stretch": {
    "method": "linear",
    "rescale": [
      [
        0,
        3000
      ]
    ]
  },
  "opacity": 1,
  "raster:mosaic": {
    "pixel_selection": "first",
    "stage": "before_channels"
  },
  "raster:tile": {
    "format": "webp",
    "tilesize": 256,
    "quality": 85
  }
}
