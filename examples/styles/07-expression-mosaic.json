{
  "version": "2.0",
  "renderer": {
    "type": "pseudocolor",
    "color_map": {
      "mode": "continuous",
      "domain": "data",
      "interpolation": "srgb",
      "stops": [
        {
          "value": -1,
          "color": "#313695ff"
        },
        {
          "value": 0,
          "color": "#ffffbfff"
        },
        {
          "value": 1,
          "color": "#006837ff"
        }
      ],
      "under": "clamp",
      "over": "clamp"
    }
  },
  "stretch": {
    "method": "none"
  },
  "mosaic": {
    "pixel_selection": "highest",
    "stage": "after_channels",
    "rank_channel": 1
  },
  "channels": {
    "kind": "expression",
    "language": "raster-expr/1",
    "expressions": [
      "(b8-b4)/(b8+b4)"
    ]
  },
  "image": {
    "format": "webp",
    "alpha": "preserve",
    "lossless": true,
    "size": 256
  }
}
