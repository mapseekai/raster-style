{
  "version": "3.0",
  "renderer": {
    "type": "pseudocolor",
    "color_mapping": {
      "mode": "continuous",
      "domain": "data",
      "interpolation": "srgb",
      "stops": [
        {
          "value": -1,
          "color": "#313695ff"
        },
        {
          "value": 0,
          "color": "#ffffbfff"
        },
        {
          "value": 1,
          "color": "#006837ff"
        }
      ],
      "under": "clamp",
      "over": "clamp"
    },
    "language": "raster-expr/1",
    "expression": "(b8-b4)/(b8+b4)"
  },
  "stretch": {
    "method": "none"
  },
  "raster:mosaic": {
    "pixel_selection": "highest",
    "stage": "after_channels",
    "rank_channel": 1
  },
  "extensions": [
    "https://mapseekai.github.io/raster-style/extensions/raster/mosaic/v1.0.0/schema.json",
    "https://mapseekai.github.io/raster-style/extensions/raster/tile/v1.0.0/schema.json"
  ],
  "raster:tile": {
    "format": "webp",
    "lossless": true,
    "tilesize": 256
  }
}
