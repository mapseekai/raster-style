{
  "version": "2.0",
  "renderer": {
    "type": "pseudocolor",
    "color_mapping": {
      "mode": "discrete",
      "domain": "data",
      "breaks": [
        0,
        100,
        500,
        1000
      ],
      "colors": [
        "#2c7bb6ff",
        "#ffffbfff",
        "#d7191cff"
      ],
      "boundary": "left_closed",
      "outside_color": "#00000000"
    },
    "bidx": [
      1
    ]
  },
  "stretch": {
    "method": "none"
  },
  "resampling": {
    "read": "nearest",
    "reproject": "nearest"
  }
}
