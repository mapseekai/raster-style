{
  "version": "2.0",
  "renderer": {
    "type": "hillshade",
    "terrain": {
      "method": "single",
      "gradient": "horn",
      "azimuth": 315,
      "altitude": 45,
      "z_factor": 1,
      "vertical_unit": "metre",
      "edge": "nodata"
    },
    "bidx": [
      1
    ]
  },
  "stretch": {
    "method": "none"
  },
  "image": {
    "format": "png",
    "tilesize": 512
  },
  "resampling": {
    "read": "bilinear",
    "reproject": "bilinear"
  }
}
