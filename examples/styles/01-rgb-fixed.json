{
  "version": "2.0",
  "renderer": {
    "type": "rgb",
    "bidx": [
      4,
      3,
      2
    ]
  },
  "stretch": {
    "method": "linear",
    "rescale": [
      [
        0,
        3000
      ],
      [
        0,
        3000
      ],
      [
        0,
        3000
      ]
    ]
  },
  "image": {
    "format": "png",
    "tilesize": 256
  },
  "resampling": {
    "read": "bilinear",
    "reproject": "bilinear"
  },
  "effects": {
    "color_formula": [
      {
        "op": "gamma",
        "channels": "r",
        "value": 1.1
      },
      {
        "op": "gamma",
        "channels": "g",
        "value": 1.1
      },
      {
        "op": "gamma",
        "channels": "b",
        "value": 1.1
      }
    ]
  }
}
