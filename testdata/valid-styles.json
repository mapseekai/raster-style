{
  "16-unicode-extension": {
    "version": "2.0",
    "extensions": {
      "mapseek.test.config": {
        "version": "1",
        "stage": "after_color",
        "config": {
          "text": "a+b & #50% 中文 / ? =",
          "numbers": [
            -0.0,
            1e+21,
            1e-07,
            5e-324
          ],
          "😀": 2,
          "": 1,
          "__proto__": {
            "safe": true
          },
          "color": "#ABCDEF"
        }
      }
    },
    "renderer": {
      "type": "gray",
      "bidx": [
        1
      ]
    }
  },
  "source-after-color": {
    "version": "2.0",
    "renderer": {
      "type": "categorized",
      "bidx": [
        1
      ],
      "color_mapping": {
        "mode": "source"
      }
    },
    "extensions": {
      "mapseek.test.identity": {
        "version": "1",
        "stage": "after_color",
        "config": {}
      }
    }
  }
}
