{
  "01-rgb-fixed": {
    "version": "2.0",
    "renderer": {
      "type": "rgb",
      "bidx": [
        4,
        3,
        2
      ]
    },
    "stretch": {
      "method": "linear",
      "rescale": [
        [
          0,
          3000
        ],
        [
          0,
          3000
        ],
        [
          0,
          3000
        ]
      ]
    },
    "image": {
      "format": "png",
      "tilesize": 256
    },
    "resampling": {
      "read": "bilinear",
      "reproject": "bilinear"
    },
    "effects": {
      "color_formula": [
        {
          "op": "gamma",
          "channels": "r",
          "value": 1.1
        },
        {
          "op": "gamma",
          "channels": "g",
          "value": 1.1
        },
        {
          "op": "gamma",
          "channels": "b",
          "value": 1.1
        }
      ]
    }
  },
  "02-ndvi-continuous": {
    "version": "2.0",
    "opacity": 1,
    "calibration": {
      "mode": "metadata"
    },
    "renderer": {
      "type": "pseudocolor",
      "color_mapping": {
        "mode": "continuous",
        "domain": "data",
        "interpolation": "srgb",
        "stops": [
          {
            "value": -1,
            "color": "#313695ff"
          },
          {
            "value": 0,
            "color": "#ffffbfff"
          },
          {
            "value": 1,
            "color": "#006837ff"
          }
        ],
        "under": "clamp",
        "over": "clamp"
      },
      "index": {
        "name": "ndvi",
        "bindings": {
          "red": 4,
          "nir": 8
        }
      }
    },
    "stretch": {
      "method": "none"
    },
    "image": {
      "format": "png",
      "tilesize": 256
    },
    "resampling": {
      "read": "bilinear",
      "reproject": "bilinear"
    }
  },
  "03-discrete-breaks": {
    "version": "2.0",
    "renderer": {
      "type": "pseudocolor",
      "color_mapping": {
        "mode": "discrete",
        "domain": "data",
        "breaks": [
          0,
          100,
          500,
          1000
        ],
        "colors": [
          "#2c7bb6ff",
          "#ffffbfff",
          "#d7191cff"
        ],
        "boundary": "left_closed",
        "outside_color": "#00000000"
      },
      "bidx": [
        1
      ]
    },
    "stretch": {
      "method": "none"
    },
    "resampling": {
      "read": "nearest",
      "reproject": "nearest"
    }
  },
  "04-categorized": {
    "version": "2.0",
    "renderer": {
      "type": "categorized",
      "color_mapping": {
        "mode": "exact",
        "entries": [
          {
            "value": 1,
            "color": "#228b22ff"
          },
          {
            "value": 2,
            "color": "#4169e1ff"
          },
          {
            "value": 3,
            "color": "#d2b48cff"
          }
        ],
        "fallback_color": "#00000000"
      },
      "bidx": [
        1
      ]
    },
    "stretch": {
      "method": "none"
    },
    "resampling": {
      "read": "nearest",
      "reproject": "nearest"
    }
  },
  "05-hillshade": {
    "version": "2.0",
    "renderer": {
      "type": "hillshade",
      "terrain": {
        "method": "single",
        "gradient": "horn",
        "azimuth": 315,
        "altitude": 45,
        "z_factor": 1,
        "vertical_unit": "metre",
        "edge": "nodata"
      },
      "bidx": [
        1
      ]
    },
    "stretch": {
      "method": "none"
    },
    "image": {
      "format": "png",
      "tilesize": 512
    },
    "resampling": {
      "read": "bilinear",
      "reproject": "bilinear"
    }
  },
  "06-percentile-stretch": {
    "version": "2.0",
    "statistics": {
      "scope": "dataset",
      "accuracy": "sample",
      "sample_size": 1000000
    },
    "renderer": {
      "type": "rgb",
      "bidx": [
        4,
        3,
        2
      ]
    },
    "stretch": {
      "method": "percentile",
      "percentiles": [
        2,
        98
      ]
    },
    "effects": {
      "color_formula": [
        {
          "op": "gamma",
          "channels": "rgb",
          "value": 1.1
        }
      ]
    }
  },
  "07-expression-mosaic": {
    "version": "2.0",
    "renderer": {
      "type": "pseudocolor",
      "color_mapping": {
        "mode": "continuous",
        "domain": "data",
        "interpolation": "srgb",
        "stops": [
          {
            "value": -1,
            "color": "#313695ff"
          },
          {
            "value": 0,
            "color": "#ffffbfff"
          },
          {
            "value": 1,
            "color": "#006837ff"
          }
        ],
        "under": "clamp",
        "over": "clamp"
      },
      "language": "raster-expr/1",
      "expression": "(b8-b4)/(b8+b4)"
    },
    "stretch": {
      "method": "none"
    },
    "image": {
      "format": "webp",
      "lossless": true,
      "tilesize": 256
    },
    "mosaic": {
      "pixel_selection": "highest",
      "stage": "after_channels",
      "rank_channel": 1
    }
  },
  "08-shaded-relief": {
    "version": "2.0",
    "renderer": {
      "type": "shaded_relief",
      "terrain": {
        "method": "single",
        "gradient": "horn",
        "azimuth": 315,
        "altitude": 45,
        "z_factor": 1,
        "vertical_unit": "metre",
        "edge": "nodata"
      },
      "strength": 0.65,
      "color_mapping": {
        "mode": "continuous",
        "domain": "data",
        "stops": [
          {
            "value": 0,
            "color": "#78a86bff"
          },
          {
            "value": 1000,
            "color": "#c9b18cff"
          },
          {
            "value": 3000,
            "color": "#ffffffff"
          }
        ]
      },
      "bidx": [
        1
      ]
    },
    "stretch": {
      "method": "none"
    }
  },
  "09-explicit-intervals": {
    "version": "2.0",
