  "11-gray-jpeg": {
    "version": "2.0",
    "renderer": {
      "type": "gray",
      "renderer_invert": false,
      "bidx": [
        1
      ]
    },
    "stretch": {
      "method": "linear",
      "rescale": [
        [
          0,
          255
