{
  "name": "@mapseek/raster-style",
  "version": "0.1.0",
  "description": "Raster Style Spec v2 JSON and Q2 query codec",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
