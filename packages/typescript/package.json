    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
